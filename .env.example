# zace 本地开发环境变量模板（W6：云端 embedding 为当前主路径）
#
# 用法（任选其一）：
#   1) 复制到 .env 后：  set -a; source .env; set +a
#   2) 每条命令前显式 export
#   3) 让 service 自己读（service 读的是进程环境，需先 export）
#
# 注意：`.env` 已被 .gitignore 排除；本文件（.env.example）不含任何密钥，可以提交。
# 为什么不用 ~/.bashrc？见 docs/tasks/TASK-046-云端embedding接入.md §C：
#   交互式 shell 才加载 .bashrc，子 AI / 脚本 / CI 都是非交互进程，拿不到其中 export 的变量。

# --- 云端 embedding（硅基流动，免费档）---
EMBED_MODE=api
# 官方 model 名（带厂商前缀）；注意：裸名 `bge-m3` 会被 API 拒绝（Model does not exist）
EMBED_MODEL=BAAI/bge-m3
# bge-m3 = 1024 维；官方支持上限 8192 token
EMBED_DIM=1024
EMBED_BASE_URL=https://api.siliconflow.cn
EMBED_MAX_INPUT_TOKENS=8192

# API key：从 ~/.bashrc 取（不要把真实值写在本文件里）
#   export EMBED_API_KEY=$(sed -n 's/^export zace_embeding_API_KEY=//p' ~/.bashrc | tr -d '"')
# 或直接在这里写（仅限 .env，绝不要提交）：
# EMBED_API_KEY=sk-xxxx

# --- 本机网络（WSL 上设了 http_proxy 时必须，否则连不上 127.0.0.1 的服务）---
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost

# --- 可选：本地 ONNX 路线（当前暂缓，见 docs/plan/phase2-m2b-w6.md §5）---
# EMBED_MODE=local
# EMBED_MODEL=multilingual-e5-small
# EMBED_CACHE_DIR=~/.cache/huggingface
