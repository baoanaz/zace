# zace 本地开发环境变量模板
#
# 用法（任选其一）：
#   1) 复制到 .env 后：  set -a; source .env; set +a
#   2) 每条命令前显式 export
#   3) 让 service 自己读（service 读的是进程环境，需先 export）
#
# 注意：`.env` 已被 .gitignore 排除；本文件（.env.example）不含任何密钥，可以提交。
# 为什么不用 ~/.bashrc？见 docs/handbook/云端embedding接入.md §1：
#   交互式 shell 才加载 .bashrc，子 AI / 脚本 / CI 都是非交互进程，拿不到其中 export 的变量。
#
# 切换 provider / 调参的完整说明见 docs/handbook/embedding-provider切换.md

# ============================================================
# 当前主路径：Voyage voyage-4-lite（200M 免费 token，32K 上下文）
# ============================================================
EMBED_MODE=api
EMBED_MODEL=voyage-4-lite
EMBED_BASE_URL=https://api.voyageai.com
EMBED_API_KEY=pa-xxxx          # Voyage key（pa- 开头）

# --- 参数（一般不用手填，会按模型自动适配；此处仅供微调参考）---
# EMBED_BATCH_SIZE=500              # 单请求条数（Voyage 安全值；1000 会因响应体过大而断连）
# EMBED_BATCH_TOKEN_BUDGET=300000   # 单请求累计 token（与上者取先到者）
# EMBED_CONCURRENCY=8               # 并发批数（Voyage 推荐 8；硅基流动免费档用 1）
# EMBED_MAX_INPUT_TOKENS=32000      # 单条截断上限（默认取模型上限）
# EMBED_PROVIDER=voyage             # 显式指定厂商（不填则按模型/base_url 推断）

# ============================================================
# 备选：硅基流动 bge-m3（免费、无限额度，但 TPM 仅 50 万）
# 用法：注释掉上面 Voyage 三行，改用下面三行，然后重新 ingest
# ============================================================
# EMBED_MODEL=bge-m3
# EMBED_BASE_URL=https://api.siliconflow.cn
# EMBED_API_KEY=sk-xxxx           # 硅基流动 key
#   · 也可写官方全名 `BAAI/bge-m3`（别名，指向同一条目，不触发重嵌）
#   · 付费档 `Pro/BAAI/bge-m3` 有独立指纹，切换会触发全量重嵌（慎用）

# --- 本机网络（WSL 上设了 http_proxy 时必须，否则连不上 127.0.0.1 的服务）---
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost

# ============================================================
# 请求日志（TASK-090）：报错后按 X-Request-Id 查"那一次请求发生了什么"
# ============================================================
# 落点：$ZACE_DATA_ROOT/logs/request.log（JSONL，一行一条请求）。stderr 仍保留一份实时输出。
# 窗口 = min(体积上界, 天数)——两个维度各管一件事：
#   · 体积：单文件写满就轮转，最多留 (备份数+1) 个文件 → 占盘有上界；
#   · 天数：启动时删掉超过保留期的文件 → 低流量下陈旧日志也会过期。
# 默认 ≈ 8 MiB × 10 = 80 MiB 上界、14 天。查日志：GET /api/request-log/{requestId}（需登录）
ZACE_LOG_MAX_BYTES=8388608       # 单文件上限（字节）；0 = 不轮转（只按天数清理，慎用）
ZACE_LOG_BACKUP_COUNT=9          # 轮转备份数（连同当前文件共 10 个）
ZACE_LOG_RETENTION_DAYS=14       # 保留天数；0 = 不按天清理（只按体积）

# ============================================================
# 可选：本地 ONNX 路线（当前暂缓，见 docs/plan/phase2-m2b-w6.md §5）
# 优点：源码不出本机；缺点：慢（本机 61 分钟/中型仓库）、模型上限 512 token
# ============================================================
# EMBED_MODE=local
# EMBED_MODEL=multilingual-e5-small
# EMBED_CACHE_DIR=~/.cache/huggingface
